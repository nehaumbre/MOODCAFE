# Environment Configuration for Mood Café

# Server Port (Google Cloud Run automatically sets PORT=8080)
PORT=8080
NODE_ENV=development

# --- Google Cloud SQL (PostgreSQL) Configuration ---
# 1. Direct connection string (TCP / Cloud SQL Auth Proxy):
# DATABASE_URL=postgresql://mood_user:YOUR_PASSWORD@127.0.0.1:5432/mood_cafe

# 2. Or individual PostgreSQL parameters:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=mood_cafe
PGSSL=false

# 3. For Google Cloud Run with Cloud SQL Unix Socket:
# INSTANCE_UNIX_SOCKET=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
